@page
@model AblePlusAdmin.Pages.Admin.LoginModel

<h2>Admin Login</h2>

<form method="post">
    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <button type="submit">Login</button>

    <p style="color:red">@Model.ErrorMessage</p>
</form>